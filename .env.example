# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Card sandbox payment (academic defense only — never a real gateway).
# When "true", buyers see a clearly-labelled "Demo Card" option at checkout
# that charges no real money. When "false" or unset, the option is hidden.
NEXT_PUBLIC_DEMO_PAYMENT_ENABLED=false
