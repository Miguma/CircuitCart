# Supabase Configuration
# Replace these with your actual Supabase project URL and Anon key
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Demo Card sandbox payment (academic defense only — never a real gateway).
# When "true", buyers see a clearly-labelled "Demo Card" option at checkout
# that charges no real money. When "false" or unset, the option is hidden.
NEXT_PUBLIC_DEMO_PAYMENT_ENABLED=false

# AI Product Verification (Hosted Multimodal AI Engine)
# Required for hosted AI classification of products and images.
# Obtain key at: https://aistudio.google.com
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Override AI model (defaults to gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: Force provider (gemini | heuristic)
# In production, leave unset or 'gemini'. If the Gemini API is unreachable or unconfigured,
# listings safely remain unpublished as 'draft' / 'uncertain' with retry enabled (never auto-approved).
# Set to 'heuristic' strictly for local offline development and test automation.
# AI_VERIFICATION_PROVIDER=gemini

# Optional: Secret for automated batch re-verification endpoint (/api/products/reverify-all)
# Exact name read by the route: ADMIN_REVERIFY_SECRET (min. 32 characters).
# Send it as header `x-admin-secret` (alias `x-admin-key`). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ADMIN_REVERIFY_SECRET=

# Server-only. Required by /api/products/[id]/verify and /api/products/reverify-all
# to call apply_product_ai_decision. Never prefix with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=

